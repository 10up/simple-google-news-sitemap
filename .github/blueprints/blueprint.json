{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/news-sitemap.xml",
  "preferredVersions": {
    "php": "7.4",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "git:directory",
          "url": "https://github.com/10up/simple-google-news-sitemap",
          "ref": "trunk"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/WordPress/theme-test-data/refs/heads/master/themeunittestdata.wordpress.xml"
      }
    }
  ]
}
